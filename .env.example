# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas → Connect → Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=patternwise

# Password you type on the /login page.
APP_PASSWORD=change-me

# 32+ random characters; signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------- AI Coach (open-weight models) ----------
# Defaults run everything locally with Ollama (https://ollama.com):
#   ollama pull gemma4:e2b-it-qat && ollama pull embeddinggemma && ollama serve
# AI_PROVIDER=ollama                    # or: openai-compatible (vLLM, llama.cpp, LM Studio, hosted Gemma…)
# AI_BASE_URL=http://localhost:11434    # OpenAI-compatible servers: https://host/v1
# AI_MODEL=gemma4:e2b-it-qat
# AI_API_KEY=                           # Bearer key for a remote model server (e.g. Ollama behind Caddy on DigitalOcean)
# AI_NUM_CTX=8192
# AI_EMBED_MODEL=embeddinggemma
# AI_EMBED_PROVIDER=                    # defaults to AI_PROVIDER
# AI_EMBED_BASE_URL=                    # defaults to AI_BASE_URL
#
# Free hosted setup (e.g. for Vercel), still Gemma end to end:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemma-4-26b-a4b-it                # or gemma-4-31b-it
# AI_API_KEY=                                # Google AI Studio key
# AI_EMBED_PROVIDER=huggingface
# AI_EMBED_MODEL=google/embeddinggemma-300m  # accept the model's licence on Hugging Face first
#                                            # (HF and Ollama vectors differ: index with the provider you query with)
# AI_EMBED_API_KEY=                          # Hugging Face fine-grained token with "Make calls to Inference Providers"
