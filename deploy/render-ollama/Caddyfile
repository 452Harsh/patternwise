{
	admin off
	auto_https off
}

# Render sends traffic to $PORT and handles TLS in front of us.
:{$PORT:10000} {
	@health path /healthz
	respond @health "ok" 200

	@authorized header Authorization "Bearer {$COACH_API_KEY}"
	handle @authorized {
		reverse_proxy 127.0.0.1:11434 {
			# Stream tokens as they're generated.
			flush_interval -1
		}
	}

	respond "Unauthorized" 401
}
